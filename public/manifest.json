{
  "manifest_version": 3,
  "name": "EduPage Cloak",
  "version": "0.3.0",
  "description": "EduPage Cloak — block EduPage and reduce tracking",
  "permissions": ["storage"],
  "host_permissions": ["*://*.edupage.org/*"],
  "content_scripts": [
    {
      "matches": ["*://*.edupage.org/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.edupage.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "answer-revealer.js"],
      "matches": ["*://*.edupage.org/*"]
    }
  ],
  "action": {
    "default_popup": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "edupage-cloak@secret.io",
      "strict_min_version": "42.0"
    }
  },
  "icons": {
    "16": "assets/images/icon16.png",
    "32": "assets/images/icon32.png",
    "48": "assets/images/icon48.png",
    "128": "assets/images/icon128.png"
  }
}
